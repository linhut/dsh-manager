{
  "name": "dsh-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Manager - DeepSeek Harness 安装与管理工具",
  "author": "DSH Manager Team",
  "license": "MIT",
  "scripts": {
    "postinstall": "npm install --workspaces",
    "build": "echo 'No build step required for JS-only packages'",
    "dev": "echo 'Run node packages/cli/src/bin.js to test'",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "start": "node packages/cli/src/bin.js",
    "dshm": "node packages/cli/src/bin.js"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/marketplace"
  ]
}
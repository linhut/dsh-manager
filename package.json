{
  "name": "dsh-manager",
  "version": "1.3.15",
  "description": "🐳 DeepSeek Harness 安装与管理工具 — 一键安装、插件市场、版本管理",
  "author": {
    "name": "linhut",
    "email": "linhut@users.noreply.github.com",
    "url": "https://github.com/linhut"
  },
  "homepage": "https://github.com/linhut/dsh-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linhut/dsh-manager.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.dshmanager.app",
    "productName": "DSH Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "packages/**/*",
      "package.json",
      "!packages/cli"
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DSH-Manager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Manager"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "DSH-Manager-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "DSH-Manager-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "packages",
        "to": "packages",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@dsh-manager/core": "*",
    "@dsh-manager/marketplace": "*",
    "execa": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "workspaces": [
    "packages/core",
    "packages/marketplace"
  ],
  "scripts": {
    "start": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('node_modules/electron/cli.js',['.']))\"",
    "dev": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('node_modules/electron/cli.js',['.'],{env:Object.assign({},process.env,{NODE_ENV:'development'})}))\"",
    "build:win": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--win']);process.exit(c)\"",
    "build:mac": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--mac']);process.exit(c)\"",
    "build:linux": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--linux']);process.exit(c)\"",
    "build:win:x64": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--win','--x64']);process.exit(c)\"",
    "build:win:arm64": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--win','--arm64']);process.exit(c)\"",
    "build:linux:x64": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--linux','--x64']);process.exit(c)\"",
    "build:linux:arm64": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--linux','--arm64']);process.exit(c)\"",
    "build:all": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));var c=0;c=h.runNode('scripts/generate-icons.js')||c;c=c||h.runNode('node_modules/electron-builder/cli.js',['--win','--mac','--linux']);process.exit(c)\"",
    "generate-icons": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('scripts/generate-icons.js'))\"",
    "postinstall": "echo 'Skipping electron-builder install-app-deps'",
    "verify": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('scripts/verify.mjs'))\"",
    "settings:backup": "node scripts/settings-tool.mjs backup",
    "settings:list": "node scripts/settings-tool.mjs list",
    "settings:restore": "node scripts/settings-tool.mjs restore",
    "settings:validate": "node scripts/settings-tool.mjs validate",
    "settings:check": "node scripts/settings-tool.mjs check",
    "settings:fix": "node scripts/settings-tool.mjs fix",
    "test": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('scripts/run-tests.mjs'))\"",
    "audit": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('scripts/verify.mjs'))\"",
    "build:test": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));h.runNode('scripts/build-test.cjs')\"",
    "release:check": "node -e \"const{dirname,join}=require('node:path');const h=require(join(dirname(process.env.npm_package_json||'./package.json'),'scripts','run-helper.cjs'));process.exit(h.runNode('scripts/release-check.mjs'))\""
  }
}
